
# CreateX - Microservices .gitignore
.postman/
postman/
# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ---------- Virtual Environments ----------
venv/
.venv/
env/
ENV/

# ---------- Environment Variables ----------
.env
.env.*
!.env.example

# ---------- Django ----------
*.sqlite3
db.sqlite3

# Django static/media files
staticfiles/
media/

# ---------- Django Migrations ----------
# Do NOT ignore migrations.
# Keep migration files in Git.

# ---------- Python Test / Coverage ----------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---------- FastAPI ----------
# Keep application source files.
# Ignore local runtime/cache files.
*.log

# ---------- Machine Learning ----------
# Ignore large generated ML artifacts
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Keep datasets if they are small and required
# dataset/

# ---------- React / Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# React/Vite build output
dist/
build/
.vite/

# ---------- IDE ----------
.vscode/
.idea/
*.iml

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
logs/
*.log

# ---------- Temporary Files ----------
*.tmp
*.temp
*.swp
*.swo

# ---------- Docker ----------
# Keep Dockerfiles and docker-compose.yml
# Ignore local Docker environment files if any
docker-data/
